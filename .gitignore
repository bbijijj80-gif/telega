```gitignore
# Build Artifacts
*.dll
*.exe
*.pdb
*.so
*.dylib
*.a
*.lib
*.o
*.obj
*.out

# Dependencies
bin/
obj/
packages/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE specific
.vs/
.vscode/
*.userprefs
*.user
*.suo
*.userosscache
*.sln.docstates

# OS generated
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Environment
.env
.env.local
.env.*

# Logs
*.log

# Temporary files
*.tmp
*.temp
*.bak
*.cache
*.pyc
__pycache__/

# User-specific (Visual Studio)
*.user
*.userosscache
*.sln.docstates

# Azure Service Fabric
PublishProfiles/

# Others
coverage/
htmlcov/
.coverage
*.gcov
*.lcov
*.profdata
*.profraw
*.db
*.sqlite
*.sqlite3

# Compressed files
*.zip
*.rar
*.7z
*.gz
*.tar
*.bz2
*.xz
*.tgz
*.tbz2
*.txz
*.jar
*.war
*.ear
*.sublime-workspace
*.swp
*.swo

# Docker
.dockerignore
!dockerfiles/

# NuGet
*.nupkg
*.snupkg
*.nuspec
nuget.exe

# MSBuild
*.userprefs

# JetBrains Rider
.idea/

# Mono
*.pidb
*.userprefs

# Backup files
*~

# Local configuration
local.settings.json

# Sensitive files
private.pkcs8.key
*_wildcard.telegram2.com-key.pem
*_wildcard.telegram2.com.pem

# Generated serialization context
MyTelegram.Schema/Entities/**/*.g.cs
MyTelegram.Messenger.NativeAot/MyMessengerJsonContext.g.cs
MyTelegram.Services/Serializers/EventDataSerializers.g.cs
MyTelegram.DataSeeder/MyMessengerJsonContext.g.cs
MyTelegram.Services/NativeAot/MyJsonSerializeContext.g.cs
```